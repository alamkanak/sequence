{
  "name": "sequence-video-editor",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && npm run build:mcp",
    "build:mcp": "node scripts/package-mcp.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "benchmark": "playwright test tests/benchmark.spec.ts --project=chromium",
    "mcp": "node companion/server.mjs",
    "check": "tsc --noEmit && node scripts/check-ui.mjs",
    "test:mcp": "node scripts/test-mcp.mjs",
    "test:mcp:package": "node scripts/test-mcp.mjs --package",
    "format": "prettier --write src tests companion scripts *.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-select": "2.4.1",
    "mediabunny": "1.62.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@webgpu/types": "0.1.74",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
